/*
  Referrer-Policy: no-referrer
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Content-Security-Policy: default-src 'self'; script-src 'self' https://challenges.cloudflare.com; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self' https://challenges.cloudflare.com; frame-src https://challenges.cloudflare.com; frame-ancestors 'none'; base-uri 'self'; form-action 'self'

# The AstroBox personal homepage embeds /astrobox/ in an iframe, so this path
# drops the anti-framing headers above (rules apply in file order).
/astrobox/*
  ! X-Frame-Options
  ! Content-Security-Policy
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self'; frame-src 'none'; object-src 'none'; base-uri 'self'; form-action 'none'
  Access-Control-Allow-Origin: *

# Build output is content-hashed, so a file name never changes meaning.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Unhashed AstroBox profile images: reuse for a day, refresh in the background.
/astrobox/covers/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/astrobox/logos/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/astrobox/mark.webp
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
